---
// Interactive fullscreen image lightbox for editorial trip photography
---

<div
  id="image-lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-caption"
  aria-hidden="true"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-pine-950/90 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-300"
>
  <!-- Close Button -->
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-6 right-6 p-3 rounded-full bg-pine-900/80 border border-white/10 text-stone-300 hover:text-white hover:border-glacial transition-colors cursor-pointer z-50"
    aria-label="Close image preview"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
    <span class="sr-only">Close image preview</span>
  </button>

  <!-- Previous / Next Navigation -->
  <button
    id="lightbox-prev"
    type="button"
    class="hidden sm:flex absolute left-4 md:left-6 top-1/2 -translate-y-1/2 p-3 rounded-full bg-pine-900/80 border border-white/10 text-stone-300 hover:text-white hover:border-glacial transition-colors cursor-pointer z-50"
    aria-label="Previous image"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button
    id="lightbox-next"
    type="button"
    class="hidden sm:flex absolute right-4 md:right-6 top-1/2 -translate-y-1/2 p-3 rounded-full bg-pine-900/80 border border-white/10 text-stone-300 hover:text-white hover:border-glacial transition-colors cursor-pointer z-50"
    aria-label="Next image"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Modal Content Container -->
  <div class="relative max-w-6xl max-h-[90vh] w-full flex flex-col items-center justify-center">
    <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-pine-950/40">
      <img id="lightbox-img" src="" alt="" class="max-h-[75vh] w-auto object-contain mx-auto transition-transform duration-300" />
    </div>

    <!-- Caption & Details -->
    <div id="lightbox-meta" class="mt-4 px-6 py-3 rounded-full glass-card max-w-2xl text-center">
      <p id="lightbox-caption" class="text-sm font-sans text-stone-200"></p>
    </div>
  </div>
</div>

<script>
  interface LightboxEntry {
    src: string;
    fallback: string;
    caption: string;
  }

  function setupLightbox() {
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    if (!lightbox || !lightboxImg || !lightboxCaption || !closeBtn) return;

    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger="true"]'));
    const entries: LightboxEntry[] = triggers.map((el) => ({
      src: el.getAttribute('data-img-src') || (el as HTMLImageElement).src,
      fallback: el.getAttribute('data-img-fallback') || el.getAttribute('data-fallback-src') || '',
      caption: el.getAttribute('data-img-caption') || (el as HTMLImageElement).alt || '',
    }));

    let currentIndex = -1;
    let previousFocus: HTMLElement | null = null;

    function showEntry(index: number) {
      if (!entries.length) return;
      currentIndex = (index + entries.length) % entries.length;
      const entry = entries[currentIndex];
      delete lightboxImg!.dataset.fallbackApplied;
      if (entry.fallback) {
        lightboxImg!.dataset.fallbackSrc = entry.fallback;
      } else {
        delete lightboxImg!.dataset.fallbackSrc;
      }
      lightboxImg!.src = entry.src;
      lightboxImg!.alt = entry.caption;
      lightboxCaption!.textContent = entry.caption;
    }

    function openLightbox(src: string, fallback: string, caption: string, index = -1) {
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      if (index >= 0) {
        showEntry(index);
      } else {
        currentIndex = entries.findIndex((item) => item.src === src);
        delete lightboxImg!.dataset.fallbackApplied;
        if (fallback) {
          lightboxImg!.dataset.fallbackSrc = fallback;
        } else {
          delete lightboxImg!.dataset.fallbackSrc;
        }
        lightboxImg!.src = src;
        lightboxImg!.alt = caption;
        lightboxCaption!.textContent = caption || '';
      }

      const showNav = entries.length > 1;
      prevBtn?.classList.toggle('hidden', !showNav);
      nextBtn?.classList.toggle('hidden', !showNav);

      lightbox!.classList.remove('opacity-0', 'pointer-events-none');
      lightbox!.classList.add('opacity-100', 'pointer-events-auto');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn!.focus();
    }

    function closeLightbox() {
      if (lightbox!.classList.contains('opacity-0')) return;
      lightbox!.classList.remove('opacity-100', 'pointer-events-auto');
      lightbox!.classList.add('opacity-0', 'pointer-events-none');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (previousFocus) {
        previousFocus.focus();
        previousFocus = null;
      }
      window.setTimeout(() => {
        if (lightboxImg && lightbox!.classList.contains('opacity-0')) {
          lightboxImg.src = '';
        }
      }, 300);
    }

    if (lightbox.dataset.initialized !== 'true') {
      lightbox.dataset.initialized = 'true';

      closeBtn.addEventListener('click', closeLightbox);
      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentIndex >= 0) showEntry(currentIndex - 1);
      });
      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentIndex >= 0) showEntry(currentIndex + 1);
      });

      lightbox.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (
          e.target === lightbox ||
          (!target.closest('#lightbox-img') &&
            !target.closest('#lightbox-meta') &&
            !target.closest('#lightbox-prev') &&
            !target.closest('#lightbox-next'))
        ) {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('opacity-0')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft' && entries.length > 1) showEntry(currentIndex - 1);
        if (e.key === 'ArrowRight' && entries.length > 1) showEntry(currentIndex + 1);
      });
    }

    triggers.forEach((img, idx) => {
      if (img.dataset.lightboxBound === 'true') return;
      img.dataset.lightboxBound = 'true';
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => {
        const entry = entries[idx];
        openLightbox(entry.src, entry.fallback, entry.caption, idx);
      });
    });

    document.querySelectorAll<HTMLElement>('[data-lightbox-btn]').forEach((btn) => {
      if (btn.dataset.lightboxBound === 'true') return;
      btn.dataset.lightboxBound = 'true';
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const src = btn.getAttribute('data-src') || '';
        const fallback = btn.getAttribute('data-fallback') || '';
        const caption = btn.getAttribute('data-caption') || '';
        const matchedIndex = entries.findIndex((item) => item.src === src);
        openLightbox(src, fallback, caption, matchedIndex);
      });
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
