---
interface TripItem {
  id: string;
  title: string;
  slug: string;
  coverImage: string;
  destination: string;
  date: string;
  elevation: string;
  category: 'Himalayan High Passes' | 'Canyons & Caves' | 'Motorcycle Trails';
  mode: string;
  excerpt: string;
  keyStops: string[];
}

const TRIPS_DATA: TripItem[] = [
  {
    id: 'arunachal-2023',
    title: 'Into the Land of Dawn-Lit Mountains: Our Himalayan Winter Road Trip',
    slug: '/trips/arunachal-pradesh-2023',
    coverImage: '/images/arunachal/PXL_20231219_074434467 sela pass.jpg',
    destination: 'Western Arunachal Pradesh',
    date: 'Dec 18 – Dec 23, 2023',
    elevation: '15,200 FT',
    category: 'Himalayan High Passes',
    mode: '4x4 Road Trip',
    excerpt: 'Sub-zero switchbacks, frozen Sela Lake, the 100-meter cataract of Nuranang Falls, the Golden Buddha of Tawang, and the remote Indo-China frontier at Bum La.',
    keyStops: ['Sela Pass', 'Nuranang Falls', 'Tawang Buddha', 'Bum La Pass', 'Sangetsar Lake', 'Dirang Valley'],
  },
  {
    id: 'meghalaya-2026',
    title: 'Chasing Clouds, Craters & Crystal Waters: A Meghalaya Motorcycle Odyssey',
    slug: '/trips/meghalaya-canyons-2026',
    coverImage: '/images/meghalaya/PXL_20260120_083114682 Krem Chympe.jpg',
    destination: 'Jaintia & Khasi Hills',
    date: 'Jan 17 – Jan 23, 2026',
    elevation: '4,900 FT',
    category: 'Canyons & Caves',
    mode: 'Motorcycle Touring',
    excerpt: 'Motorcycle expedition through limestone canyons, the cobalt amphitheater of Phe Phe Falls, swimming into the cavernous arch of Krem Chympe on bamboo rafts, and transparent river currents.',
    keyStops: ['Phe Phe Falls', 'Krem Chympe Cave', 'Wah Umngot', 'Mawsmai Fossils', 'Mawkdok Dympep Gorge'],
  },
];

const categories = ['All', 'Himalayan High Passes', 'Canyons & Caves', 'Motorcycle Trails'];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const normalize = (p: string) => (p.startsWith('/') && !p.startsWith(base + '/')) ? `${base}${p}` : p;
---

<div class="space-y-8" id="trips-archive-container">
  <!-- Category Filter Buttons -->
  <div class="flex flex-wrap gap-2.5 pb-2" role="tablist" aria-label="Trip Categories">
    {categories.map((cat, idx) => (
      <button
        type="button"
        data-filter={cat}
        class={`filter-btn px-4 py-2 rounded-full text-xs font-medium tracking-wide transition-all duration-200 cursor-pointer ${
          idx === 0
            ? 'active-filter bg-glacial text-pine-950 font-bold shadow-glow-teal'
            : 'glass-card text-stone-300 hover:text-white hover:border-glacial/40'
        }`}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Grid of Trip Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="trips-grid">
    {TRIPS_DATA.map((trip) => {
      const safeCoverImage = encodeURI(normalize(trip.coverImage));
      const safeWebpCover = safeCoverImage.replace(/\.(jpe?g|png)$/i, '.webp');
      const tripUrl = normalize(trip.slug);
      return (
        <article
          data-category={trip.category}
          data-mode={trip.mode}
          class="trip-item group relative flex flex-col rounded-3xl overflow-hidden glass-card glass-card-hover border border-alpine-border transition-all duration-300"
        >
          <!-- Image Header -->
          <div class="relative h-64 sm:h-72 w-full overflow-hidden bg-pine-900">
            <picture>
              <source srcset={safeWebpCover} type="image/webp" />
              <img
                src={safeWebpCover}
                alt={trip.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                onerror={`if (this.src !== '${safeCoverImage}') { this.src = '${safeCoverImage}'; } else { this.classList.add('opacity-40'); }`}
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-pine-950 via-pine-950/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity" />

            <!-- Elevation & Mode Badges -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none z-10">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wider bg-pine-950/85 backdrop-blur-md text-glacial border border-glacial/40 shadow-md">
                <svg class="w-3 h-3 text-glacial" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                {trip.elevation}
              </span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-medium tracking-wide bg-pine-950/85 backdrop-blur-md text-dawn-ochre border border-dawn-ochre/30 shadow-md">
                {trip.mode}
              </span>
            </div>

            <!-- Category Pill -->
            <div class="absolute bottom-4 left-4 z-10">
              <span class="px-2.5 py-1 rounded-md text-[11px] uppercase tracking-wider font-semibold bg-glacial/20 text-glacial backdrop-blur-md border border-glacial/30">
                {trip.category}
              </span>
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs text-stone-400 font-sans">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {trip.date}
                </span>
                <span class="text-glacial/90 font-medium">{trip.destination}</span>
              </div>

              <h3 class="font-serif text-2xl font-bold text-stone-100 group-hover:text-glacial transition-colors leading-snug">
                <a href={tripUrl}>
                  <span class="absolute inset-0" aria-hidden="true" />
                  {trip.title}
                </a>
              </h3>

              <p class="text-sm text-stone-300 font-sans leading-relaxed line-clamp-3">
                {trip.excerpt}
              </p>

              <div class="pt-2 flex flex-wrap gap-1.5">
                {trip.keyStops.map((stop) => (
                  <span class="px-2 py-0.5 rounded text-[11px] bg-pine-900/80 text-stone-400 border border-white/5">
                    {stop}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs uppercase font-sans font-semibold tracking-wider text-glacial group-hover:text-white transition-colors">
                Open Expedition Log
              </span>
              <div class="w-8 h-8 rounded-full bg-pine-800 flex items-center justify-center border border-white/10 group-hover:bg-glacial group-hover:border-glacial text-stone-300 group-hover:text-pine-950 transition-all duration-300">
                <svg class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</div>

<script>
  function initTripsFilter() {
    const container = document.getElementById('trips-archive-container');
    if (!container) return;

    const buttons = container.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = container.querySelectorAll<HTMLElement>('.trip-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;

        // Update active button state
        buttons.forEach((b) => {
          b.classList.remove('active-filter', 'bg-glacial', 'text-pine-950', 'font-bold', 'shadow-glow-teal');
          b.classList.add('glass-card', 'text-stone-300');
        });
        btn.classList.add('active-filter', 'bg-glacial', 'text-pine-950', 'font-bold', 'shadow-glow-teal');
        btn.classList.remove('glass-card', 'text-stone-300');

        // Filter cards
        items.forEach((item) => {
          const category = item.getAttribute('data-category');
          const mode = item.getAttribute('data-mode') || '';

          let matches = false;
          if (filter === 'All') {
            matches = true;
          } else if (filter === 'Motorcycle Trails') {
            matches = mode.includes('Motorcycle') || category === 'Motorcycle Trails';
          } else {
            matches = category === filter;
          }

          if (matches) {
            item.style.display = 'flex';
            setTimeout(() => {
              item.style.opacity = '1';
              item.style.transform = 'scale(1)';
            }, 10);
          } else {
            item.style.opacity = '0';
            item.style.transform = 'scale(0.96)';
            setTimeout(() => {
              item.style.display = 'none';
            }, 200);
          }
        });
      });
    });
  }

  initTripsFilter();
  document.addEventListener('astro:page-load', initTripsFilter);
</script>
