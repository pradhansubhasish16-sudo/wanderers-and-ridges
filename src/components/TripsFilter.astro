---
import TripCard from './TripCard.astro';
import { TRIPS, TRIP_CATEGORIES } from '../data/trips';
---

<div class="space-y-8" id="trips-archive-container">
  <!-- Category Filter Buttons -->
  <div class="flex flex-wrap gap-2.5 pb-2" role="tablist" aria-label="Trip Categories">
    {TRIP_CATEGORIES.map((cat, idx) => (
      <button
        type="button"
        role="tab"
        aria-selected={idx === 0 ? 'true' : 'false'}
        data-filter={cat}
        class={`filter-btn px-4 py-2 rounded-full text-xs font-medium tracking-wide transition-all duration-200 cursor-pointer ${
          idx === 0
            ? 'active-filter bg-glacial text-pine-950 font-bold shadow-glow-teal'
            : 'glass-card text-stone-300 hover:text-white hover:border-glacial/40'
        }`}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Grid of Trip Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="trips-grid" role="tabpanel">
    {TRIPS.map((trip) => (
      <TripCard
        title={trip.title}
        slug={trip.slug}
        coverImage={trip.coverImage}
        destination={trip.destination}
        date={trip.date}
        elevation={trip.elevation}
        category={trip.category}
        mode={trip.mode}
        excerpt={trip.archiveExcerpt}
        keyStops={trip.keyStops}
        ctaLabel="Open Expedition Log"
        className="trip-item transition-all duration-300"
        dataCategory={trip.category}
        dataMode={trip.mode}
      />
    ))}
  </div>
</div>

<script>
  function initTripsFilter() {
    const container = document.getElementById('trips-archive-container');
    if (!container || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    const buttons = container.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = container.querySelectorAll<HTMLElement>('.trip-item');
    const pendingTimers = new WeakMap<HTMLElement, number>();

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;

        // Update active button state & ARIA
        buttons.forEach((b) => {
          b.classList.remove('active-filter', 'bg-glacial', 'text-pine-950', 'font-bold', 'shadow-glow-teal');
          b.classList.add('glass-card', 'text-stone-300');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active-filter', 'bg-glacial', 'text-pine-950', 'font-bold', 'shadow-glow-teal');
        btn.classList.remove('glass-card', 'text-stone-300');
        btn.setAttribute('aria-selected', 'true');

        // Filter cards safely without animation race conditions
        items.forEach((item) => {
          const existingTimer = pendingTimers.get(item);
          if (existingTimer !== undefined) {
            window.clearTimeout(existingTimer);
            pendingTimers.delete(item);
          }

          const category = item.getAttribute('data-category');
          const mode = item.getAttribute('data-mode') || '';

          let matches = false;
          if (filter === 'All') {
            matches = true;
          } else if (filter === 'Motorcycle Trails') {
            matches = mode.includes('Motorcycle') || category === 'Motorcycle Trails';
          } else {
            matches = category === filter;
          }

          if (matches) {
            item.style.display = 'flex';
            const timer = window.setTimeout(() => {
              item.style.opacity = '1';
              item.style.transform = 'scale(1)';
              pendingTimers.delete(item);
            }, 10);
            pendingTimers.set(item, timer);
          } else {
            item.style.opacity = '0';
            item.style.transform = 'scale(0.96)';
            const timer = window.setTimeout(() => {
              item.style.display = 'none';
              pendingTimers.delete(item);
            }, 200);
            pendingTimers.set(item, timer);
          }
        });
      });
    });
  }

  initTripsFilter();
  document.addEventListener('astro:page-load', initTripsFilter);
</script>
