---
interface Props {
  title: string;
  slug: string;
  coverImage: string;
  destination: string;
  date: string;
  elevation: string;
  category: string;
  mode: string;
  excerpt: string;
  keyStops: string[];
  featured?: boolean;
}

const {
  title,
  slug,
  coverImage,
  destination,
  date,
  elevation,
  category,
  mode,
  excerpt,
  keyStops,
  featured = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedCover = (coverImage.startsWith('/') && !coverImage.startsWith(base + '/')) ? `${base}${coverImage}` : coverImage;
const safeCoverImage = encodeURI(normalizedCover);
const safeWebpCover = safeCoverImage.replace(/\.(jpe?g|png)$/i, '.webp');
const normalizedSlug = (slug.startsWith('/') && !slug.startsWith(base + '/')) ? `${base}${slug}` : slug;
---

<article class={`group relative flex flex-col rounded-3xl overflow-hidden glass-card glass-card-hover border border-alpine-border ${featured ? 'md:grid md:grid-cols-12 md:gap-8' : ''}`}>
  <!-- Image Container -->
  <div class={`relative overflow-hidden ${featured ? 'md:col-span-7 h-72 sm:h-96 md:h-full min-h-[300px]' : 'h-64 sm:h-72'} w-full bg-pine-900`}>
    <picture>
      <source srcset={safeWebpCover} type="image/webp" />
      <img
        src={safeWebpCover}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        onerror={`if (this.src !== '${safeCoverImage}') { this.src = '${safeCoverImage}'; } else { this.classList.add('opacity-40'); }`}
      />
    </picture>
    
    <!-- Subtle gradient wash -->
    <div class="absolute inset-0 bg-gradient-to-t from-pine-950 via-pine-950/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>

    <!-- Badges on top of image -->
    <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none z-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wider bg-pine-950/85 backdrop-blur-md text-glacial border border-glacial/40 shadow-md">
        <svg class="w-3 h-3 text-glacial" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
        {elevation}
      </span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-medium tracking-wide bg-pine-950/85 backdrop-blur-md text-dawn-ochre border border-dawn-ochre/30 shadow-md">
        {mode}
      </span>
    </div>

    <!-- Category tag bottom left of image -->
    <div class="absolute bottom-4 left-4 z-10">
      <span class="px-2.5 py-1 rounded-md text-[11px] uppercase tracking-wider font-semibold bg-glacial/20 text-glacial backdrop-blur-md border border-glacial/30">
        {category}
      </span>
    </div>
  </div>

  <!-- Content Container -->
  <div class={`p-6 sm:p-8 flex flex-col justify-between flex-grow ${featured ? 'md:col-span-5' : ''}`}>
    <div class="space-y-4">
      <!-- Date & Destination -->
      <div class="flex items-center justify-between text-xs text-stone-400 font-sans">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {date}
        </span>
        <span class="text-glacial/90 font-medium">{destination}</span>
      </div>

      <!-- Title -->
      <h3 class="font-serif text-2xl sm:text-3xl font-bold text-stone-100 group-hover:text-glacial transition-colors leading-snug">
        <a href={normalizedSlug} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-stone-300 font-sans leading-relaxed line-clamp-3">
        {excerpt}
      </p>

      <!-- Key Stops Pills -->
      <div class="pt-2 flex flex-wrap gap-1.5">
        {keyStops.map((stop) => (
          <span class="px-2 py-0.5 rounded text-[11px] bg-pine-900/80 text-stone-400 border border-white/5">
            {stop}
          </span>
        ))}
      </div>
    </div>

    <!-- Read CTA link -->
    <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between">
      <span class="text-xs uppercase font-sans font-semibold tracking-wider text-glacial group-hover:text-white transition-colors flex items-center gap-1">
        Read Full Expedition Journal
      </span>
      <div class="w-8 h-8 rounded-full bg-pine-800 flex items-center justify-center border border-white/10 group-hover:bg-glacial group-hover:border-glacial text-stone-300 group-hover:text-pine-950 transition-all duration-300">
        <svg class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </div>
  </div>
</article>
