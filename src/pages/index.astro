---
import BaseLayout from '../layouts/BaseLayout.astro';
import SafeImage from '../components/SafeImage.astro';
import TripCard from '../components/TripCard.astro';
import ElevationBadge from '../components/ElevationBadge.astro';

const featuredTrips = [
  {
    title: 'Into the Land of Dawn-Lit Mountains: Our Himalayan Winter Road Trip',
    slug: '/trips/arunachal-pradesh-2023',
    coverImage: '/images/arunachal/PXL_20231219_074434467 sela pass.jpg',
    destination: 'Western Arunachal Pradesh (Tawang, Bum La, Dirang)',
    date: 'Dec 18 – Dec 23, 2023',
    elevation: '15,200 FT',
    category: 'Himalayan High Passes',
    mode: '4x4 Road Trip',
    excerpt: 'An extreme winter transit across frozen high-altitude lakes, military frontier outposts, thundering cataracts at Nuranang, and ancient Buddhist sanctuaries overlooking the eastern Himalayas.',
    keyStops: ['Sela Pass (13,700 ft)', 'Nuranang Falls', 'Tawang Buddha', 'Bum La Pass (15,200 ft)', 'Sangetsar Lake', 'Dirang Valley'],
  },
  {
    title: 'Chasing Clouds, Craters & Crystal Waters: A Meghalaya Motorcycle Odyssey',
    slug: '/trips/meghalaya-canyons-2026',
    coverImage: '/images/meghalaya/PXL_20260120_083114682 Krem Chympe.jpg',
    destination: 'West & East Jaintia Hills, East Khasi Hills',
    date: 'Jan 17 – Jan 23, 2026',
    elevation: '4,900 FT',
    category: 'Canyons & Caves',
    mode: 'Motorcycle Touring',
    excerpt: 'Carving through cloud-shrouded serpentine mountain tarmac, wading turquoise river canyons, and paddling bamboo rafts into the towering limestone caverns of Krem Chympe.',
    keyStops: ['Phe Phe Falls', 'Krem Chympe River Gorge', 'Wah Umngot River', 'Mawsmai Fossils', 'Mawkdok Dympep Valley'],
  },
];
---

<BaseLayout
  title="Wanderers & Ridges | High Mountain Passes & Canyon Trails"
  description="High mountain passes, subterranean rivers, and canyon trails across India. A personal travel journal by Subhasish Pradhan."
  currentPath="/"
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-24 md:pt-20 md:pb-32 overflow-hidden">
    <!-- Topographic ambient radial decoration -->
    <div class="absolute inset-0 topographic-bg opacity-30 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <!-- Expedition Status Pill -->
      <div class="flex items-center gap-3 mb-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium tracking-wider bg-pine-900/90 text-glacial border border-glacial/40 shadow-inner">
          <span class="w-2 h-2 rounded-full bg-glacial animate-ping"></span>
          <span>FIELD JOURNAL • NORTH-EAST INDIA</span>
        </div>
        <div class="hidden sm:inline-block">
          <ElevationBadge elevation="15,200 FT" location="BUM LA PASS" type="summit" />
        </div>
      </div>

      <!-- Main Headline -->
      <div class="max-w-4xl space-y-6">
        <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-stone-100 leading-[1.08]">
          Where the Pavement Ends, <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-glacial via-teal-300 to-dawn-ochre">
            The Ridges Begin.
          </span>
        </h1>
        <p class="text-base sm:text-xl text-stone-300 font-sans font-light leading-relaxed max-w-2xl">
          A personal expedition journal navigating sub-zero Himalayan switchbacks, roaring glacial gorges, and the sunless subterranean rivers of the Meghalayan plateau.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/trips"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-glacial text-pine-950 font-sans font-semibold text-sm hover:bg-glacial-light transition-all duration-200 shadow-glow-teal cursor-pointer"
          >
            <span>Explore All Expeditions</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/about"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full glass-card text-stone-300 hover:text-white hover:border-glacial/50 text-sm font-sans font-medium transition-colors"
          >
            <span>Read Rider Manifesto</span>
          </a>
        </div>
      </div>

      <!-- Hero Visual Showcase Split -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <!-- Hero Image 1: Arunachal Sela Pass -->
        <div class="md:col-span-7">
          <SafeImage
            src="/images/arunachal/PXL_20231219_074434467 sela pass.jpg"
            alt="Sela Pass at 13,700 FT"
            caption="Sela Pass, 13,700 FT. Sub-zero winds carving across frozen alpine lake shores and sacred prayer flags."
            aspectRatio="wide"
            elevation="13,700 FT"
            location="Sela Pass, Arunachal"
            priority={true}
          />
        </div>

        <!-- Hero Image 2: Meghalaya Krem Chympe -->
        <div class="md:col-span-5">
          <SafeImage
            src="/images/meghalaya/PXL_20260120_083114682 Krem Chympe.jpg"
            alt="Krem Chympe River Arch"
            caption="Krem Chympe, Jaintia Hills. Steering bamboo rafts deep into the mouth of the subterranean river."
            aspectRatio="square"
            elevation="Subterranean River"
            location="East Jaintia Hills"
            priority={true}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Key Expedition Metrics Bar -->
  <section class="border-y border-alpine-border bg-pine-900/50 backdrop-blur-md py-8">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="space-y-1">
          <div class="font-mono text-3xl sm:text-4xl font-extrabold text-glacial">15,200 FT</div>
          <div class="text-xs font-sans uppercase tracking-widest text-stone-400">Peak Elevation (Bum La)</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl sm:text-4xl font-extrabold text-dawn-ochre">2</div>
          <div class="text-xs font-sans uppercase tracking-widest text-stone-400">Flagship Expeditions</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl sm:text-4xl font-extrabold text-stone-100">1,850+ KM</div>
          <div class="text-xs font-sans uppercase tracking-widest text-stone-400">4x4 & Motorcycle Trails</div>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-3xl sm:text-4xl font-extrabold text-emerald-400">0%</div>
          <div class="text-xs font-sans uppercase tracking-widest text-stone-400">Trace Left Behind</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Expeditions Section -->
  <section class="py-24 max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-glacial font-semibold">Curated Logs</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-100 mt-2">
          Featured Mountain & Canyon Stories
        </h2>
      </div>
      <a href="/trips" class="inline-flex items-center gap-1.5 text-sm font-sans font-medium text-glacial hover:text-white transition-colors">
        <span>View all trip archives</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="space-y-10">
      {featuredTrips.map((trip) => (
        <TripCard
          title={trip.title}
          slug={trip.slug}
          coverImage={trip.coverImage}
          destination={trip.destination}
          date={trip.date}
          elevation={trip.elevation}
          category={trip.category}
          mode={trip.mode}
          excerpt={trip.excerpt}
          keyStops={trip.keyStops}
          featured={true}
        />
      ))}
    </div>
  </section>

  <!-- Traveler Philosophy / Field Manifesto -->
  <section class="py-20 bg-pine-900/30 border-t border-alpine-border relative">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-mono uppercase tracking-widest text-dawn-ochre font-semibold">Traveler Manifesto</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-100 mt-2">
          The Ethics of High-Altitude & Karst Exploration
        </h2>
        <p class="text-stone-300 font-sans text-sm mt-3 leading-relaxed">
          Exploring sensitive border regions and prehistoric cave complexes is a privilege that demands acute mindfulness, mechanical resilience, and absolute ecological humility.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Principle 1 -->
        <div class="p-8 rounded-3xl glass-card border border-white/5 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-pine-800 flex items-center justify-center border border-glacial/30 text-glacial">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-stone-100">Sub-Zero Frontier Respect</h3>
          <p class="text-xs text-stone-400 font-sans leading-relaxed">
            At altitudes exceeding 15,000 feet, weather dictates the terms. We honor military checkposts, secure mandatory Inner Line Permits (ILP), and yield unconditionally to unpredictable ice storms.
          </p>
        </div>

        <!-- Principle 2 -->
        <div class="p-8 rounded-3xl glass-card border border-white/5 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-pine-800 flex items-center justify-center border border-dawn-ochre/30 text-dawn-ochre">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-stone-100">Living Cave Sanctuaries</h3>
          <p class="text-xs text-stone-400 font-sans leading-relaxed">
            Limestone gours and stalagmites take millennia to form. In caves like Krem Chympe and Mawsmai, we swim and climb without touching delicate calcite formations or disturbing underground bat colonies.
          </p>
        </div>

        <!-- Principle 3 -->
        <div class="p-8 rounded-3xl glass-card border border-white/5 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-pine-800 flex items-center justify-center border border-emerald-400/30 text-emerald-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-stone-100">Leave No Trace</h3>
          <p class="text-xs text-stone-400 font-sans leading-relaxed">
            Every piece of wrapper, dry bag clip, or tyre scrap is packed out and returned to urban centers for responsible disposal. We leave only footsteps and wet paddle ripples behind.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
