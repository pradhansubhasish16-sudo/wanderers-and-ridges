---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
}

const {
  title = 'Wanderers & Ridges | High Mountain Passes & Canyon Trails',
  description = 'High mountain passes, subterranean rivers, and canyon trails across India. A personal travel journal by Subhasish Pradhan.',
  image = '/images/arunachal/PXL_20231219_074434467 sela pass.jpg',
  currentPath = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://wanderersandridges.local');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2338A3A5' stroke-width='2'><path d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'/></svg>" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="min-h-screen flex flex-col bg-pine-950 text-stone-200 antialiased selection:bg-glacial/30 selection:text-white">
    <!-- Atmospheric Ambient Lighting Elements -->
    <div class="fixed top-0 left-1/4 w-[500px] h-[350px] bg-glacial/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
    <div class="fixed top-1/3 right-10 w-[600px] h-[400px] bg-botanical-green/10 blur-[150px] rounded-full pointer-events-none -z-10"></div>
    <div class="fixed bottom-10 left-10 w-[550px] h-[350px] bg-dawn-ochre/5 blur-[140px] rounded-full pointer-events-none -z-10"></div>

    <Navbar currentPath={currentPath} />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    
    <!-- Fullscreen Lightbox for photos -->
    <ImageLightbox />
  </body>
</html>
